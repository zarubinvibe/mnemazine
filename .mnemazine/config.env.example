# Mnemazine local config — copy to .mnemazine/config.env (gitignored) and set values.
# Never commit real host/key values. Sourced by the Telegram sync/poll scripts.
MNEMAZINE_VPS="root@YOUR_VPS_HOST"
MNEMAZINE_VPS_KEY="$HOME/.ssh/id_rsa"
MNEMAZINE_REMOTE_INBOX="/var/www/mnemazine-inbox"
MNEMAZINE_INBOX=""
MNEMAZINE_REMOTE_MUTATION=1
MNEMAZINE_PUSH_REPORTS=0
